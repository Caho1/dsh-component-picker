{
  "name": "@local/dsh-component-picker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude-style element picker for the dsh built-in Browser tab: hover-highlight a page element, click it, and its element/component/props/source/screenshot travel with your message.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caho1/dsh-component-picker.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "browser",
    "element-picker",
    "component-inspector",
    "claude"
  ],
  "license": "MIT",
  "author": "Caho1"
}
